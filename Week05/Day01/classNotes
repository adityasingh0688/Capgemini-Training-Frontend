<div class="container mt-4">
  <h2>Dynamic Form Example</h2>
  @for (item of profileFormGroups; track $index)
  {
  <form [formGroup]="item" class="mb-4">
      <div class="form-group">
        <label for="username-{{$index}}">Username</label>
        <input id="username-{{$index}}" formControlName="username" class="form-control" />
        @if (item.get('username')?.touched && item.get('username')?.invalid)
        {
            @if(item.get('username')?.errors?.['required'])
            {
            <span class="text-danger">Username is required.</span>
            }
        }
      </div>    
      <div class="form-group">
        <label for="age-{{$index}}">Age</label>
        <input id="age-{{$index}}" formControlName="age" class="form-control" type="number" />
        @if (item.get('age')?.touched && item.get('age')?.invalid)
        {
            @if(item.get('age')?.errors?.['required'])
            {
            <span class="text-danger">Age is required.</span>
            }
            @if(item.get('age')?.errors?.['min'])
            {
            <span class="text-danger">Age must be a positive number.</span>
            }
        }
        </div>
        <div class="form-group">
        <label for="city-{{$index}}">City</label>
        <input id="city-{{$index}}" formControlName="city" class="form-control" />
        @if (profileForm.get('city')?.touched && profileForm.get('city')?.invalid)
        {
            @if(profileForm.get('city')?.errors?.['required'])
            {  
            <span class="text-danger">City is required.</span>
            }
            @if(profileForm.get('city')?.errors?.['minlength'])
            {
            <span class="text-danger">City must be at least 3 characters long.</span>
            }
        }
        </div>
        <div class="form-group">
        <label for="profile-{{$index}}">Select Profile</label>
        <select id="profile-{{$index}}" formControlName="profile" class="form-control">
         @for (profile of profiles; track $index)
         {
            <option [value]="profile">{{ profile }}</option>
         }
        </select>
        @if (profileForm.get('profile')?.touched && profileForm.get('profile')?.invalid)
        {
            @if(profileForm.get('profile')?.errors?.['required'])
            {  
            <span class="text-danger">Profile selection is required.</span>
            }
        }
        </div>
        <button class="btn btn-danger mt-2" (click)="removeProfile($index)">Remove Profile</button>
       
    </form>
}
  <button class="btn btn-success" (click)="submitProfiles()">Submit Profiles</button>
  <button class="btn btn-warning ml-2" (click)="addProfile()" [disabled]="profileFormGroups.length === 0">Add Profile</button>
  <button class="btn btn-danger ml-2" (click)="removeProfile(profileFormGroups.length - 1)" [disabled]="profileFormGroups.length === 0">Remove Last Profile</button>
</div>
 
 